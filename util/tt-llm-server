#!/usr/bin/env bash
# tt-llm-server — OpenAI-compatible LLM server on a single Blackhole p150.
#
# Runs the tt-inference-server vLLM (tt-metal integration fork) image, which
# serves an OpenAI-compatible API on :8000 (/v1/chat/completions, /v1/models,
# /health). This is Layer 5 of the stack: the model backend the Pi agentic
# harness (util/pi-p150a) talks to.
#
# The validated single-p150 recipe (tt-inference-server 0.15, image pinned to
# tt-metal 55fd115 / vLLM aa4ae1e) is:
#   docker run ... <image> --model Llama-3.1-8B-Instruct --tt-device p150
# Single-card caps: max context 65536, max batch 32 (status: experimental).
#
# Overridable via env (defaults shown):
#   TT_LLM_IMAGE   pinned vllm-tt-metal image
#   TT_LLM_MODEL   Llama-3.1-8B-Instruct   (Instruct = chat/tool-following; the
#                                            base Llama-3.1-8B won't drive Pi)
#   TT_LLM_DEVICE  p150
#   TT_LLM_PORT    8000
#   HF_TOKEN       REQUIRED — gated Llama weights are pulled on first run
#   JWT_SECRET     optional — if set, the server enforces Bearer-token auth and
#                  the client key is HS256(jwt, {"team_id":"tenstorrent",
#                  "token_id":"debug-test"}). Unset = open server (PoC default).
#
# First run downloads the weights into the named volume (tt_llm_cache_<model>)
# and JIT-compiles Blackhole kernels — expect several minutes before /health
# goes green. Subsequent runs reuse the volume.
set -euo pipefail

IMAGE="${TT_LLM_IMAGE:-ghcr.io/tenstorrent/tt-inference-server/vllm-tt-metal-src-release-ubuntu-22.04-amd64:0.10.0-55fd115-aa4ae1e}"
MODEL="${TT_LLM_MODEL:-Llama-3.1-8B-Instruct}"
DEVICE="${TT_LLM_DEVICE:-p150}"
PORT="${TT_LLM_PORT:-8000}"

: "${HF_TOKEN:?tt-llm-server: export HF_TOKEN (gated Llama weights). Token: https://huggingface.co/settings/tokens — and accept the Llama-3.1 license on HF}"

exec docker run --rm -it \
  --ipc=host \
  --log-driver none \
  --publish "${PORT}:8000" \
  --device=/dev/tenstorrent:/dev/tenstorrent \
  --mount type=bind,src=/dev/hugepages-1G,dst=/dev/hugepages-1G \
  --volume "tt_llm_cache_${MODEL}:/home/container_app_user/cache_root" \
  --env "HF_TOKEN=${HF_TOKEN}" \
  ${JWT_SECRET:+--env "JWT_SECRET=${JWT_SECRET}"} \
  "${IMAGE}" \
  --model "${MODEL}" \
  --tt-device "${DEVICE}" \
  "$@"
