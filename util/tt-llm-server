#!/usr/bin/env bash
# tt-llm-server — manage an OpenAI-compatible vLLM server on the single p150,
# driven by tt-inference-server's run.py. This is the Layer 5/6 model backend
# the Pi agentic harness (util/pi-p150a) talks to.
#
#   tt-llm-server up [MODEL]   start the server (detached); print connect details
#   tt-llm-server down         stop the running server container
#   tt-llm-server status       container state + /health + served model id
#   tt-llm-server logs         follow the container log
#   tt-llm-server key          print the derived client API key (for Pi)
#   tt-llm-server url          print the OpenAI base URL
#
# `up` accepts -w/--wait to block until /health is green.
#
# Why run.py and not a raw `docker run`: the released image is configured by env
# + a generated model-spec JSON (CACHE_ROOT, MODEL_WEIGHTS_PATH, MESH_DEVICE,
# TT_MODEL_SPEC_JSON_PATH, …), not CLI flags. run.py resolves the (image, tt-metal,
# vLLM, vllm-args) spec for the model+device and launches the container detached.
# One-time setup of the pinned clone + venv: `make llm-setup`.
#
# Config via env (defaults shown):
#   TT_LLM_MODEL    Llama-3.1-8B-Instruct   (any tt-inference-server P150 catalog model)
#   TT_LLM_DEVICE   p150
#   TT_LLM_PORT     8001                    (8000 is held by the docs server)
#   TT_LLM_JWT      p150-local-secret       (auth is mandatory; client key is derived from it)
#   TT_LLM_PARSER   <auto by family>        (tool-call parser; coding agents need it or chat 400s)
#   HF_TOKEN        env, else ~/.cache/huggingface/token
#   TTIS_DIR        $TT_ROOT/src/tt-inference-server
#
# Local mode (Phase 2 stub, for the gemma4 fork — not a catalog model):
#   TT_LLM_LOCAL=1  serve a locally-built tt-metal+vLLM via run.py --local-server.
#                   Requires TT_LLM_VENV (python_env with tt-metal + vLLM + the model
#                   registered) and TT_LLM_SPEC_JSON (a runtime model-spec). See the
#                   `_local` branch below for the prerequisites still to be wired.
set -euo pipefail

ROOT="${TT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
TTIS_DIR="${TTIS_DIR:-${ROOT}/src/tt-inference-server}"
VENV="${TTIS_DIR}/.run-venv"
PY="${VENV}/bin/python"

MODEL_DEFAULT="${TT_LLM_MODEL:-Llama-3.1-8B-Instruct}"
DEVICE="${TT_LLM_DEVICE:-p150}"
PORT="${TT_LLM_PORT:-8001}"
JWT="${TT_LLM_JWT:-p150-local-secret}"
BASE_URL="http://localhost:${PORT}/v1"

die() { echo "tt-llm-server: $*" >&2; exit 1; }

require_setup() {
	[ -x "${PY}" ] || die "run.py venv missing (${VENV}). Run: make llm-setup"
	[ -f "${TTIS_DIR}/run.py" ] || die "tt-inference-server clone missing (${TTIS_DIR}). Run: make llm-setup"
}

resolve_hf_token() {
	if [ -z "${HF_TOKEN:-}" ]; then
		local f="${HF_TOKEN_FILE:-${HF_HOME:-${HOME}/.cache/huggingface}/token}"
		[ -s "${f}" ] && HF_TOKEN="$(tr -d '[:space:]' < "${f}")"
	fi
	[ -n "${HF_TOKEN:-}" ] || die "no HF token. Run \`hf auth login\` or export HF_TOKEN (https://huggingface.co/settings/tokens)"
	export HF_TOKEN
}

# Tool-call parser per model family (vLLM needs --tool-call-parser to accept the
# `tools` array coding agents send). Empty => no tool-calling override.
parser_for() {
	[ -n "${TT_LLM_PARSER:-}" ] && { echo "${TT_LLM_PARSER}"; return; }
	case "$1" in
		Llama-4*)            echo "llama4_json" ;;
		Llama-3*|Meta-Llama-3*) echo "llama3_json" ;;
		Qwen*)               echo "hermes" ;;
		Mistral*)            echo "mistral" ;;
		*)                   echo "" ;;   # unknown family: serve without tool-calling
	esac
}

derive_key() { "${PY}" -W ignore -c 'import jwt,sys; print(jwt.encode({"team_id":"tenstorrent","token_id":"debug-test"}, sys.argv[1], algorithm="HS256"))' "${JWT}"; }

LOCAL_NAME="tt-llm-local"
container() { docker ps --filter "name=tt-inference-server-" --filter "name=${LOCAL_NAME}" --format '{{.ID}}' | head -1; }

health_code() { curl -s -o /dev/null -w "%{http_code}" --max-time 3 "http://localhost:${PORT}/health" 2>/dev/null || echo 000; }

served_model() {
	curl -s -H "Authorization: Bearer $(derive_key)" --max-time 3 "${BASE_URL}/models" 2>/dev/null \
		| "${PY}" -c 'import sys,json;
try: print(json.load(sys.stdin)["data"][0]["id"])
except Exception: pass' 2>/dev/null
}

_docker_up() {
	local model="$1"; shift
	local parser; parser="$(parser_for "${model}")"
	local override=()
	if [ -n "${parser}" ]; then
		override=(--vllm-override-args "{\"enable-auto-tool-choice\": true, \"tool-call-parser\": \"${parser}\"}")
		echo "==> tool-call parser: ${parser}"
	else
		echo "==> no tool-call parser for '${model}' — tool-calling disabled (set TT_LLM_PARSER to override)"
	fi
	cd "${TTIS_DIR}"
	AUTOMATIC_HOST_SETUP=1 JWT_SECRET="${JWT}" \
	"${PY}" run.py \
		--model "${model}" --device "${DEVICE}" \
		--workflow server --docker-server --service-port "${PORT}" \
		--skip-system-sw-validation \
		"${override[@]}" "$@"
}

# Local mode: serve a locally-built tt-metal + vLLM (the gemma4 fork) by running
# `vllm serve` INSIDE the tt-metal-build container (the python_env libs are built
# for Ubuntu and won't load on the Arch host; gemma4 isn't a run.py catalog model
# either). Reuses third_party/tt-metal (python_env with vLLM installed) + the
# assembled model dir. Open server (no JWT) — any client key works.
#
#   TT_LLM_MODEL_DIR   $TT_ROOT/.cache/models/gemma-4-12B-it   (host path; mounted via /work)
#   TT_LLM_SERVED_NAME gemma-4-12B-it
#   TT_LLM_MESH        P150
#   TT_LLM_MAXSEQS     1        (single-card 12B: little KV headroom over ~24GB weights)
#   TT_LLM_MAXLEN      4096
#   TT_BUILD_IMAGE     tt-metal-build:22.04
_local_up() {
	local model="$1"; shift
	local img="${TT_BUILD_IMAGE:-tt-metal-build:22.04}"
	local mdir_host="${TT_LLM_MODEL_DIR:-${ROOT}/.cache/models/${model}}"
	[ -d "${mdir_host}" ] || die "[local] model dir not found: ${mdir_host} (set TT_LLM_MODEL_DIR)"
	local mdir_c="/work/${mdir_host#"${ROOT}/"}"          # same dir as seen inside the container (/work=$ROOT)
	local served="${TT_LLM_SERVED_NAME:-${model}}"
	local mesh="${TT_LLM_MESH:-P150}"
	local maxseqs="${TT_LLM_MAXSEQS:-1}"
	local maxlen="${TT_LLM_MAXLEN:-4096}"
	[ -e /dev/tenstorrent ] || die "[local] /dev/tenstorrent not present"
	echo "==> local serve: ${served} from ${mdir_host} (mesh=${mesh}, max-num-seqs=${maxseqs}, ctx=${maxlen})"
	echo "==> tool-calling: OFF (no vLLM parser for gemma4 yet — coding agents that send 'tools' will 400)"
	docker run -d --rm --name "${LOCAL_NAME}" \
		--privileged \
		--device=/dev/tenstorrent:/dev/tenstorrent \
		--volume=/dev/hugepages-1G:/dev/hugepages-1G \
		--volume="${ROOT}:/work" \
		--workdir=/work/third_party/tt-metal \
		--env=TT_METAL_HOME=/work/third_party/tt-metal \
		--shm-size=32g \
		--publish "${PORT}:${PORT}" \
		"${img}" \
		bash -lc "source python_env/bin/activate && \
			MESH_DEVICE=${mesh} VLLM_PLUGINS=tt,tt_model_registry HF_HUB_OFFLINE=1 HF_MODEL=${mdir_c} \
			exec vllm serve ${mdir_c} --host 0.0.0.0 --port ${PORT} \
				--served-model-name ${served} \
				--max-num-seqs ${maxseqs} --max-model-len ${maxlen} --block-size 64 \
				--no-enable-prefix-caching $*" >/dev/null
}

cmd_up() {
	local local_mode="${TT_LLM_LOCAL:-0}"
	local wait=0; local args=()
	while [ $# -gt 0 ]; do
		case "$1" in
			-w|--wait) wait=1; shift ;;
			*) args+=("$1"); shift ;;
		esac
	done
	local model
	if [ "${local_mode}" = "1" ]; then
		model="${args[0]:-${TT_LLM_MODEL:-gemma-4-12B-it}}"
	else
		require_setup; resolve_hf_token
		model="${args[0]:-${MODEL_DEFAULT}}"
	fi
	[ ${#args[@]} -gt 0 ] && args=("${args[@]:1}")

	local cid; cid="$(container)"
	[ -n "${cid}" ] && die "a server container is already running (${cid}). Stop it first: tt-llm-server down"

	if [ "${local_mode}" = "1" ]; then _local_up "${model}" "${args[@]}"; else _docker_up "${model}" "${args[@]}"; fi

	cid="$(container)"
	echo
	echo "==> server launched (container ${cid:-?}); model='${model}', port ${PORT}"
	echo "    base URL : ${BASE_URL}"
	if [ "${local_mode}" = "1" ]; then echo "    auth     : open (any client key works)"; else echo "    API key  : $(derive_key)"; fi
	echo "    connect  : util/pi-p150a            (discovers the served id)"
	if [ "${wait}" = "1" ]; then
		echo -n "==> waiting for /health "
		for _ in $(seq 1 200); do
			[ "$(health_code)" = "200" ] && { echo " green ($(served_model))"; return 0; }
			[ -n "$(container)" ] || { echo " — container exited"; return 1; }
			echo -n "."; sleep 6
		done
		echo " timeout"; return 1
	fi
}

cmd_down() {
	local cid; cid="$(container)"
	[ -n "${cid}" ] || { echo "no server container running"; return 0; }
	echo "==> stopping ${cid}"; docker stop "${cid}" >/dev/null && echo "stopped"
}

cmd_status() {
	local cid; cid="$(container)"
	if [ -z "${cid}" ]; then echo "server: DOWN (no container)"; return 0; fi
	echo "server   : ${cid} ($(docker ps --filter id="${cid}" --format '{{.Status}}'))"
	echo "health   : $(health_code) (${BASE_URL%/v1}/health)"
	local m; m="$(served_model)"; echo "model    : ${m:-<not ready>}"
	echo "base URL : ${BASE_URL}"
}

cmd_logs() { local cid; cid="$(container)"; [ -n "${cid}" ] || die "no server container running"; exec docker logs -f "${cid}"; }

case "${1:-}" in
	up)     shift; cmd_up "$@" ;;
	down)   cmd_down ;;
	status) cmd_status ;;
	logs)   cmd_logs ;;
	key)    require_setup; derive_key ;;
	url)    echo "${BASE_URL}" ;;
	""|-h|--help) sed -n '2,40p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
	*) die "unknown command '$1' (up|down|status|logs|key|url)" ;;
esac
